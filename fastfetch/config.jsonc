{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Downloads/logo-plain.txt",
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "keyColor": "blue"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰌽 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󰨇 WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰞷 Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "keyColor": "green"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
